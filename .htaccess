# Apache configuration for the LitCORP website.

# Consolidate indexing signals on the HTTPS, non-www domain.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(?:www\.)?korpusprozy\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.korpusprozy\.com$ [NC]
    RewriteRule ^ https://korpusprozy.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Prefer the static homepage and fall back to PHP where needed.
DirectoryIndex index.html index.php

# Do not expose directory contents when an index file is missing.
Options -Indexes

# The website content is encoded as UTF-8.
AddDefaultCharset UTF-8

# Prevent access to hidden files and common local/configuration artifacts.
<FilesMatch "(^\.|\.(?:bak|conf|dist|ini|log|sql|swp)|composer\.(?:json|lock)|package-lock\.json)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
